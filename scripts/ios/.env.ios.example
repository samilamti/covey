# Tillsammans — iOS deployment env vars
# Copy to scripts/ios/.env.ios (gitignored) and fill in values.

# --- App Store Connect API key ---
# Generate at: App Store Connect → Users and Access → Keys
# Role required: App Manager (or higher) for app creation; Developer for builds
ASC_KEY_ID=F7E0JYRHFJRU
ASC_ISSUER_ID=69a6de83-189c-47e3-e053-5b8c7c11a4d1
ASC_TEAM_ID=MYZCEVW795
# altool/xcodebuild auto-discover the key here when given just the Key ID:
ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_F7E0JYRHFJRU.p8"

# --- App identity ---
APP_BUNDLE_ID=se.covey.app
APP_NAME=Covey
APP_SKU=covey-ios-001
PRIMARY_LOCALE=sv

# --- Versioning ---
# MARKETING_VERSION is the user-visible version (e.g. "1.0.0")
# BUILD_NUMBER must increase for every TestFlight upload
MARKETING_VERSION=1.0.0
BUILD_NUMBER=1
