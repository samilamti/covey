# Tillsammans — local-only deployment config (sourced by scripts/deploy/*.sh)
# Copy to .env.local (gitignored) and fill in values.

# --- Production VPS ---
PROD_HOST=46.246.48.39
PROD_USER=tillsammans
# Path to a passphrase-free SSH private key (use a working copy under /tmp,
# never commit a private key — see scripts/deploy/README.md)
PROD_KEY="/tmp/covey-deploy/key"
# Sudo password for PROD_USER (used by `sudo -S` to operate as PROD_DEPLOY_USER)
PROD_SUDO_PASS="In 2026, together is strong"

# --- Application layout on the VPS ---
PROD_DEPLOY_USER=deploy
PROD_APP_DIR=/home/deploy/apps/tillsammans
