# Tillsammans — Production Environment Variables
# Copy to .env.prod and fill in all values before deploying.
#
# Generate secrets:
#   POSTGRES_PASSWORD: openssl rand -base64 32 | tr -d '=/+' | head -c 40
#   JWT_SECRET:        openssl rand -base64 64 | tr -d '=/+' | head -c 80
#   VAPID keys:        cd backend && npx web-push generate-vapid-keys

# --- Domain & TLS ---
DOMAIN=covey.se
ACME_EMAIL=sentinel@covey.se

# --- Database ---
POSTGRES_USER=tillsammans_prod
POSTGRES_PASSWORD=
POSTGRES_DB=tillsammans

# --- Authentication ---
JWT_SECRET=
AUTH_PROVIDER=stub
# AUTH_PROVIDER=bankid  # Real BankID (v6 Secure Start). Needs FEATURE_BANKID_AUTH=true + certs below.

# --- BankID (only used when AUTH_PROVIDER=bankid + FEATURE_BANKID_AUTH=true) ---
# Defaults below target the FREE test environment. Run scripts/bankid/setup-test-cert.sh
# to populate backend/certs/, then open /api/auth/bankid/dev. See docs/bankid-test.md.
# BANKID_API_URL=https://appapi2.test.bankid.com/rp/v6.0   # prod: https://appapi2.bankid.com/rp/v6.0
# BANKID_CERT_PATH=backend/certs/test-client-cert.pem
# BANKID_KEY_PATH=backend/certs/test-client-key.pem
# BANKID_CA_PATH=backend/certs/ca_test.crt
# BANKID_CERT_PASSPHRASE=        # set only if the RP key is encrypted (prod)

# --- Feature flags ---
FEATURE_BANKID_AUTH=false
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_GEOLOCATION=true
FEATURE_COMMUNITIES=true
FEATURE_POINTS_SYSTEM=false

# --- Push notifications (VAPID for web, Firebase for native apps) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:sentinel@covey.se
# Firebase service account JSON (one line, for native iOS/Android push via FCM).
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then: cat firebase-service-account.json | jq -c .
FIREBASE_SERVICE_ACCOUNT=

# --- Deploy webhook ---
# Secret shared between GitHub Actions (repo secret DEPLOY_WEBHOOK_SECRET) and the webhook listener.
# Generate: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=
