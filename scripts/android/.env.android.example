# Tillsammans / Covey — Android deployment env vars
# Copy to scripts/android/.env.android (gitignored) and fill in.

# --- App identity ---
PACKAGE_NAME=se.covey
APP_NAME=Covey
PRIMARY_LOCALE=sv-SE

# --- Firebase (for the google-services.json fetch in 01-firebase-config.sh) ---
FIREBASE_PROJECT_ID=covey-ade47

# --- Signing ---
# Passwords live in the macOS Keychain, NOT in this file. 02-keystore.sh stores
# them; 03-build-aab.sh reads them back. These name the Keychain entry:
KEYCHAIN_ACCOUNT=covey-android
KEYCHAIN_PASSWORD_SERVICE=covey-upload-keystore-password
# Optional keystore path override; defaults to frontend/android/covey-upload.jks
KEYSTORE_PATH=
KEY_ALIAS=covey-upload

# --- Google Play Developer API (04/05) ---
# Service-account JSON from Play Console → Setup → API access → Service accounts.
# Keep it OUTSIDE the repo. 00-prereqs.sh verifies it can authenticate.
PLAY_SA_JSON=$HOME/.config/covey/play-service-account.json
# Track to publish to:
#   internal  — Internal testing (≤100 testers, instant, no gate; good first smoke test)
#   alpha     — Closed testing  (this is the "Closed testing" track; starts the 14-day clock)
#   beta      — Open testing
#   production
# Custom closed tracks created in the console use their own track name here.
TRACK=alpha
# Release status: completed | draft | inProgress | halted
RELEASE_STATUS=completed
# Release notes shown to testers (kept short; per-locale notes set in 05).
RELEASE_NOTES="First Android release of Covey."

# --- Versioning (informational; versionCode/Name come from build.gradle) ---
APP_VERSION=1.0.0
